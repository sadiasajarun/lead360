# ═══════════════════════════════════════════════════════════════════════════════
#  Lead360 — root environment template (docker-compose ONLY)
#
#  Copy to `.env` in the repo root. NEVER commit `.env`.
#  This file configures the local Postgres container. It does NOT configure the apps —
#  those read backend/.env and frontend/.env.
#
#  Whatever you set here must match the DATABASE_* values in backend/.env.
# ═══════════════════════════════════════════════════════════════════════════════

POSTGRES_USER=lead360
POSTGRES_PASSWORD=change-me-for-local-dev
POSTGRES_DB=lead360
POSTGRES_PORT=5432
