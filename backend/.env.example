# ═══════════════════════════════════════════════════════════════════════════════
#  Lead360 — Backend environment template
#
#  Copy to `backend/.env` and fill in the blanks.  NEVER commit `backend/.env`.
#  Every variable marked [REQUIRED] must have a value or the app will not boot / will misbehave.
#  Variables marked [PLANNED] are NOT read by any code yet — they are reserved for infrastructure
#  described in the PRD but not implemented. Leave them blank; the app ignores them.
#
#  Full setup: .claude-project/docs/DEVELOPER_HANDOFF.md
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# IANA timezone that defines the business calendar day for dashboard buckets (today / yesterday).
# Set this to the team's timezone, not the server's - a UTC host would otherwise roll the day over mid-morning.
APP_TIMEZONE=Asia/Dhaka
# Must exactly match the URL the browser loads the frontend from, or cookies will not be sent.
CORS_ORIGIN=http://localhost:5173
# Used to build invitation links emailed/handed to new users. Set to the public frontend URL.
APP_URL=http://localhost:5173

# ─── Database (PostgreSQL 15+ with the `vector` extension) ────────────────────
# [REQUIRED] Any Postgres with pgvector. Neon works out of the box (set DATABASE_SSL=true).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lead360
DATABASE_PASSWORD=
DATABASE_NAME=lead360
DATABASE_SSL=false

# Auto-creates tables from the entity classes on boot.
#   true  — throwaway local databases ONLY. It DROPS columns and indexes it does not know about
#           (the pgvector HNSW indexes), and a column TYPE change makes it drop+recreate the column,
#           resetting every value — which is how a whole history of created_at timestamps was lost.
#   false — REQUIRED for any database holding data you care about, incl. shared dev. Use
#           `npm run migration:run` (or a one-off script like src/database/fix-timestamptz.ts).
DATABASE_SYNCHRONIZE=false

# Only for src/database/restore-timestamps.ts: connection string of a Neon point-in-time branch to
# copy created_at/updated_at/deleted_at back from. Leave unset in normal operation.
# RESTORE_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (JWT delivered in httpOnly cookies) ─────────────────────────────────
# [REQUIRED] The app throws `JWT_SECRET is required` at boot if this is missing. No fallback.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES=1h
# [REQUIRED] Must be a DIFFERENT random string from JWT_SECRET.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d
# true in production (HTTPS). With `false` over HTTPS the browser drops the auth cookie.
COOKIE_SECURE=false

# ─── Object storage — proposals, budgets, uploads, logos, avatars ─────────────
#   local — writes to ./backend/uploads (development only; not durable, not shared between pods)
#   r2    — Cloudflare R2      | s3 — AWS S3 or any S3-compatible endpoint
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lead360-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI — OpenAI Platform (or any OpenAI-compatible endpoint) ─────────────────
# [REQUIRED] Without this, proposal/budget/brief/pitch generation and RAG search all fail.
# Get a key at https://platform.openai.com/api-keys  (format: sk-proj-...)
# Measured cost ≈ $0.12 per generated lead. Model choice, costs, and the procedure for switching
# models: .claude-project/docs/AI_MODEL_GUIDE.md
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-5.4
# Pinned to 768 dimensions to match the pgvector columns. Changing this model requires re-embedding
# EVERYTHING: `npm run ingest:riseup` then POST /api/portfolio/embed.
AI_EMBED_MODEL=text-embedding-3-small
# Per-1M-token USD list price — used ONLY for the dev-console cost logs and the generation diagnostics
# (never billed). Defaults match gpt-5.4 ($2.50 in / $15 out) + text-embedding-3-small ($0.02). Override
# when you switch models so the logged $ figures stay truthful.
AI_PRICE_IN_PER_1M=2.5
AI_PRICE_OUT_PER_1M=15
AI_EMBED_PRICE_PER_1M=0.02

# ─── Generation engine tuning ─────────────────────────────────────────────────
# Cosine distance at or below which a past same-template case is reused as the plan (strong match).
CASE_STRONG_MATCH_MAX_DIST=0.35
# Learning Engine v2 flags: off | shadow | on (default off). `shadow` computes V2 and records it in
# internalCalc but serves V1. Any V2 error or timeout falls back to V1. Turn a flag `on` only after
# `npm run backtest` shows no metric worse than the V1 baseline (.claude-project/docs/BACKTEST.md).
ENGINE_V2_GOLD=off
ENGINE_V2_FEATURES=off
ENGINE_V2_CALIBRATION=off

# ─── Live currency conversion ─────────────────────────────────────────────────
# Called only when an admin presses "Sync" in Settings → Rates & Currency. Outbound HTTPS to this
# host must be allowed. USD and BDT prices come from the head-cost sheet and never use this rate.
FX_API_URL=https://open.er-api.com/v6/latest/USD

# ─── Knowledge-base seed corpus ───────────────────────────────────────────────
# Where `npm run ingest:riseup` reads Riseup's past proposals from.
# Defaults to backend/data/kb-seed (committed to this repo). Override only to point elsewhere.
RISEUP_DB_DIR=

# ─── Email ────────────────────────────────────────────────────────────────────
# The email module is BUILT but intentionally DISABLED. Invitations return a link for the admin to
# copy and send manually. Do not enable without a product decision.
EMAIL_ENABLED=false
MAIL_FROM=no-reply@riseuplabs.com

# ─── [PLANNED] Not read by any code yet ───────────────────────────────────────
# Present so infrastructure can be provisioned ahead of the work. The app does not contact these.
# REDIS_HOST=            # BullMQ queue + cache — not wired
# REDIS_PORT=6379
# REDIS_PASSWORD=
# SES_REGION=            # transactional email — not wired (see EMAIL_ENABLED above)
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SENTRY_DSN=            # error tracking — not wired
