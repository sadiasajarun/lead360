# ═══════════════════════════════════════════════════════════════════════════════
#  Lead360 — Frontend environment template
#
#  Copy to `frontend/.env`.  NEVER commit `frontend/.env`.
#  Vite only exposes variables prefixed with VITE_ to the browser — so never put a secret here.
#  Anything in this file ships to the client in plain text.
# ═══════════════════════════════════════════════════════════════════════════════

# [REQUIRED] Base URL of the backend API, including the /api prefix.
# Must be the same origin the backend allows in CORS_ORIGIN, or the auth cookie will be dropped.
#   local:      http://localhost:3000/api
#   production: https://api.your-domain.com/api
VITE_API_URL=http://localhost:3000/api
